# Disable Directory Browsing
Options -Indexes

# Enable Rewrite Engine
RewriteEngine On
RewriteBase /

# Force HTTPS (optional but highly recommended for secure logins)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Redirect internal browser requests for actual .html files to their clean, non-extension URL
# e.g., /about.html -> /about
RewriteCond %{THE_REQUEST} \s/+(.*?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# Internally redirect clean URLs without extensions back to .html if the file exists
# e.g., /about -> /about.html
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# Let standard PHP files run normally without interference
# e.g., /api.php or any other PHP script can be called directly
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]
